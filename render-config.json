{
  "agents": {
    "defaults": {
      "model": "openai-codex/gpt-6.1-sol",
      "provider": "openai_codex",
      "fallbackModels": []
    }
  },
  "providers": {},
  "gateway": {
    "host": "127.0.0.1",
    "port": 18790
  },
  "channels": {
    "websocket": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 8766,
      "tokenIssueSecret": "${NANOBOT_WEB_TOKEN}",
      "websocketRequiresToken": true
    },
    "telegram": {
      "enabled": false,
      "allowFrom": [],
      "richMessages": true,
      "streaming": true
    }
  },
  "tools": {
    "speech": {
      "enabled": true,
      "voice": "en-US-AriaNeural"
    },
    "imageGeneration": {
      "enabled": true,
      "provider": "openai_codex",
      "model": "gpt-image-2"
    },
    "restrictToWorkspace": true,
    "webuiAllowRemotePackageInstall": false,
    "my": {
      "allowSet": false
    }
  }
}
